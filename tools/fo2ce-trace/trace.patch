@@ -0,0 +1,15 @@
+#ifndef FALLOUT_ORACLE_H_
+#define FALLOUT_ORACLE_H_
+
+// Hexwaste trace oracle (tools/fo2ce-trace). Everything here is inert unless [oracle]enabled=1.
+namespace fallout {
+
+bool oracleEnabled();
+void oracleInit();
+unsigned int oracleTicks();
+void oracleAdvanceClock(unsigned int ms);
+void oracleTick();
+
+} // namespace fallout
+
+#endif
