+void oracleTraceMove(Object* obj, int fromTile, int toTile)
+{
+    if (fromTile == toTile || PID_TYPE(obj->pid) != OBJ_TYPE_CRITTER) {
+        return;
+    }
+    oracleLine("MOVE obj#%d %d->%d", obj->id, fromTile, toTile);
+}
