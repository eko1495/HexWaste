+
+namespace fallout {
+
+static bool gOracleEnabled = false;
+static unsigned int gOracleClock = 0;
+static long long gOracleExitAfterMs = -1;
+static char gOracleRngDumpPath[1024] = "";
+static int gOracleSeed = 12345;
+static bool gOracleRecipeRunning = false;
+static char gOracleMakeSavePath[1024] = "";
+static char gOracleScenarioPath[1024] = "";
+static char gOracleTracePath[1024] = "";
+static char gOracleFixtureName[128] = "";
+static bool gOracleDudeAwaitingInput = false;
+static bool gOracleClockMoved = false; // a tick/delay advanced the clock since the last renderPresent
+
+static constexpr unsigned int kOracleStepMs = 10;
+
+bool oracleEnabled()
+{
+    return gOracleEnabled;
+}
+
+void oracleInit()
+{
+    int enabled = 0;
+    configGetInt(&gGameConfig, "oracle", "enabled", &enabled);
+    gOracleEnabled = enabled != 0;
+    if (!gOracleEnabled) {
+        return;
+    }
+    int exitAfterMs = -1;
+    if (configGetInt(&gGameConfig, "oracle", "exit_after_ms", &exitAfterMs) && exitAfterMs >= 0) {
+        gOracleExitAfterMs = exitAfterMs;
+    }
+    char* dumpPath = nullptr;
+    if (configGetString(&gGameConfig, "oracle", "rng_dump", &dumpPath) && dumpPath != nullptr) {
+        snprintf(gOracleRngDumpPath, sizeof(gOracleRngDumpPath), "%s", dumpPath);
+    }
+    configGetInt(&gGameConfig, "oracle", "seed", &gOracleSeed);
+    char* savePath = nullptr;
+    if (configGetString(&gGameConfig, "oracle", "make_save", &savePath) && savePath != nullptr) {
+        snprintf(gOracleMakeSavePath, sizeof(gOracleMakeSavePath), "%s", savePath);
+    }
+    char* str = nullptr;
+    if (configGetString(&gGameConfig, "oracle", "scenario", &str) && str != nullptr) {
+        snprintf(gOracleScenarioPath, sizeof(gOracleScenarioPath), "%s", str);
+    }
+    str = nullptr;
+    if (configGetString(&gGameConfig, "oracle", "trace", &str) && str != nullptr) {
+        snprintf(gOracleTracePath, sizeof(gOracleTracePath), "%s", str);
+    }
+    str = nullptr;
+    if (configGetString(&gGameConfig, "oracle", "fixture", &str) && str != nullptr) {
+        snprintf(gOracleFixtureName, sizeof(gOracleFixtureName), "%s", str);
+    }
+}
+
+const char* oracleScenarioPath() { return gOracleScenarioPath; }
+const char* oracleTracePath() { return gOracleTracePath; }
+const char* oracleFixtureName() { return gOracleFixtureName; }
+bool oracleDudeAwaitingInput() { return gOracleDudeAwaitingInput; }
+void oracleSetDudeAwaitingInput(bool on) { gOracleDudeAwaitingInput = on; }
+
+const char* oracleMakeSavePath()
+{
+    return gOracleMakeSavePath;
+}
+
+static void oracleScenarioStep();
+
+static int oracleFail(const char* what, const char* arg)
+{
+    fprintf(stderr, "oracle: recipe failed at %s %s\n", what, arg);
+    return -1;
+}
+
+// the body of main.cc mainLoop minus rendering/key handling
+static void oracleRunFor(unsigned int ms)
+{
+    scriptsEnable();
+    unsigned int end = oracleTicks() + ms;
+    while (oracleTicks() < end) {
+        inputGetInput();
+        scriptsHandleRequests();
+        mapHandleTransition();
+    }
+    scriptsDisable();
+}
+
+static int oracleRunRecipeLines(FILE* in);
+
+int oracleRunRecipe(const char* path)
+{
+    FILE* in = fopen(path, "rt");
+    if (in == nullptr) {
+        return oracleFail("open", path);
+    }
+    gOracleRecipeRunning = true;
+    int rc = oracleRunRecipeLines(in);
+    gOracleRecipeRunning = false;
+    fclose(in);
+    return rc;
+}
+
+static int oracleRunRecipeLines(FILE* in)
+{
+    char line[256];
+    while (fgets(line, sizeof(line), in) != nullptr) {
+        char* hash = strchr(line, '#');
+        if (hash != nullptr) *hash = '\0';
+        char cmd[32] = { 0 }, a[128] = { 0 };
+        int n1 = 0, n2 = 0, n3 = 0;
+        if (sscanf(line, "%31s", cmd) != 1) continue;
+        if (strcmp(cmd, "premade") == 0 && sscanf(line, "%*s %127s", a) == 1) {
+            char gcd[160];
+            snprintf(gcd, sizeof(gcd), "premade\\%s.gcd", a);
+            if (_proto_dude_init(gcd) == -1) return oracleFail("premade", a);
+        } else if (strcmp(cmd, "map") == 0 && sscanf(line, "%*s %127s", a) == 1) {
+            if (_main_load_new(a) != 0) return oracleFail("map", a);
+        } else if (strcmp(cmd, "place") == 0 && sscanf(line, "%*s %d %d %d", &n1, &n2, &n3) == 3) {
+            objectSetLocation(gDude, n1, n2, nullptr);
+            objectSetRotation(gDude, n3, nullptr);
+        } else if (strcmp(cmd, "gvar") == 0 && sscanf(line, "%*s %d %d", &n1, &n2) == 2) {
+            gameSetGlobalVar(n1, n2);
+        } else if (strcmp(cmd, "run-ms") == 0 && sscanf(line, "%*s %d", &n1) == 1) {
+            oracleRunFor((unsigned int)n1);
+        } else if (strcmp(cmd, "save") == 0) {
+            const char* desc = line + 4;
+            while (*desc == ' ') desc++;
+            char d[64];
+            snprintf(d, sizeof(d), "%s", desc);
+            size_t len = strlen(d);
+            while (len > 0 && (d[len - 1] == '\n' || d[len - 1] == '\r' || d[len - 1] == ' ')) d[--len] = '\0';
+            if (lsgSaveGameHeadless(9, d) == -1) return oracleFail("save", d);
+        } else {
+            return oracleFail("unknown recipe command", cmd);
+        }
+    }
+    return 0;
+}
+
+const char* oracleRngDumpPath()
+{
+    return gOracleRngDumpPath;
+}
+
+int oracleSeed()
+{
+    return gOracleSeed;
+}
+
+void oracleWriteRngVectors(const char* path, int seed)
+{
+    FILE* out = fopen(path, "wt");
+    if (out == nullptr) {
+        exit(2);
+    }
+    static const int kRanges[][2] = { { 1, 100 }, { 1, 6 }, { 0, 0 }, { 0, 1 }, { 5, 1 }, { -10, 10 }, { 1, 25 } };
+    oracleRandomSeed(seed);
+    for (int i = 0; i < 1000; i++) {
+        const int* r = kRanges[i % 7];
+        int v = randomBetweenAt(r[0], r[1], "dump", "dump");
+        fprintf(out, "seed=%d min=%d max=%d -> %d\n", seed, r[0], r[1], v);
+    }
+    fclose(out);
+}
+
+unsigned int oracleTicks()
+{
+    return gOracleClock;
+}
+
+void oracleAdvanceClock(unsigned int ms)
+{
+    gOracleClock += ms;
+    gOracleClockMoved = true;
+}
+
+// Render-only-loop guard, called from renderPresent. Some engine wait loops are gated on
+// getTicksSince() but only render (gameMouseRefresh/renderPresent/throttle) - they never reach
+// tickersExecute or delay_ms, so under the virtual clock they would spin forever (e.g.
+// interfaceBarEndButtonsShow at every _combat_begin). If no tick/delay advanced the clock since
+// the previous present, advance it by one step. Loops that do tick keep exactly 10 ms per tick.
+void oracleRenderGuard()
+{
+    if (!gOracleClockMoved) {
+        gOracleClock += kOracleStepMs;
+    }
+    gOracleClockMoved = false;
+}
+
+void oracleRecipeCombatAbort()
+{
+    if (gOracleRecipeRunning) {
+        fprintf(stderr, "oracle: recipe entered combat\n");
+        exit(3);
+    }
+}
+
+void oracleTick()
+{
+    if (gOracleRecipeRunning && isInCombat()) {
+        oracleRecipeCombatAbort();
+    }
+    gOracleClock += kOracleStepMs;
+    gOracleClockMoved = true;
+    oracleScenarioStep();
+    if (gOracleExitAfterMs >= 0 && (long long)gOracleClock >= gOracleExitAfterMs) {
+        fprintf(stderr, "oracle: exit_after_ms=%lld reached at clock %u\n", gOracleExitAfterMs, gOracleClock);
+        exit(0);
+    }
+}
+
+static FILE* gOracleTrace = nullptr;
+
+bool oracleTracing()
+{
+    return gOracleTrace != nullptr;
+}
+
+static void oracleTraceClose()
+{
+    if (gOracleTrace != nullptr) {
+        fflush(gOracleTrace);
+        fclose(gOracleTrace);
+        gOracleTrace = nullptr;
+    }
+}
+
+void oracleTraceOpen(const char* path, const char* header)
+{
+    if (path == nullptr || path[0] == '\0') {
+        return;
+    }
+    gOracleTrace = fopen(path, "wt");
+    if (gOracleTrace == nullptr) {
+        fprintf(stderr, "oracle: cannot open trace %s\n", path);
+        exit(2);
+    }
+    fprintf(gOracleTrace, "# %s\n", header);
+    atexit(oracleTraceClose);
+}
+
+static void oracleLine(const char* fmt, ...)
+{
+    if (!oracleTracing()) {
+        return;
+    }
+    fprintf(gOracleTrace, "t=%u ", gameTimeGetTime());
+    va_list args;
+    va_start(args, fmt);
+    vfprintf(gOracleTrace, fmt, args);
+    va_end(args);
+    fputc('\n', gOracleTrace);
+}
