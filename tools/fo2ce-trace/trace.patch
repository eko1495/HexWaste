+
+// ---- scenario runner -------------------------------------------------------------------
+// Grammar (shared with Hexwaste): `seed <int>` (first), `wait <ms>`, `end-turn [count]`.
+// Once combat starts, control lives inside fo2ce's own combat loops, so the runner is a step
+// machine driven from oracleTick() (every tickersExecute pass) rather than a sequential loop.
+// The sequential specification is:
+//   wait ms     -> run the engine for ms virtual ms
+//   end-turn n  -> n times: run until dude awaits combat input (or no combat -> action ends);
+//                  enqueue KEY_SPACE (_combat_input breaks on it, combat.cc); run 10 ms; run
+//                  until dude awaits input again or combat ended. Each seek capped at 600000 ms.
+
+enum OracleScenarioState {
+    ORACLE_SCN_IDLE, // not armed
+    ORACLE_SCN_NEXT, // fetch the next command
+    ORACLE_SCN_WAIT_UNTIL,
+    ORACLE_SCN_ENDTURN_SEEK_INPUT,
+    ORACLE_SCN_ENDTURN_PRESSED,
+    ORACLE_SCN_ENDTURN_SEEK_NEXT,
+};
+
+struct OracleScenarioCmd {
+    int kind; // 0 = wait, 1 = end-turn
+    int arg;
+};
+
+static constexpr unsigned int kOracleEndTurnCapMs = 600000;
+static constexpr int kOracleScenarioMaxCmds = 256;
+
+static OracleScenarioCmd gOracleScnCmds[kOracleScenarioMaxCmds];
+static int gOracleScnCount = 0;
+static int gOracleScnIndex = 0;
+static OracleScenarioState gOracleScnState = ORACLE_SCN_IDLE;
+static unsigned int gOracleScnUntil = 0; // WAIT_UNTIL / PRESSED target, or seek deadline
+static int gOracleScnTurnsLeft = 0;
+static bool gOracleScnInStep = false;
+static unsigned int gOracleScnWorkTicks = 0; // ticks whose work ran while the scenario was armed
+
+[[noreturn]] static void oracleScenarioFailExit(const char* what, int code)
+{
+    fprintf(stderr, "oracle: scenario failed: %s (cmd %d, clock %u)\n", what, gOracleScnIndex, gOracleClock);
+    exit(code); // atexit closes the (partial) trace
+}
+
+void oracleScenarioBegin(const char* path)
+{
+    FILE* in = fopen(path, "rt");
+    if (in == nullptr) {
+        fprintf(stderr, "oracle: cannot open scenario %s\n", path);
+        exit(6);
+    }
+    char line[128];
+    bool seeded = false;
+    while (fgets(line, sizeof(line), in) != nullptr) {
+        char* hash = strchr(line, '#');
+        if (hash != nullptr) *hash = '\0';
+        char cmd[32] = { 0 };
+        int n = 0;
+        if (sscanf(line, "%31s", cmd) != 1) continue;
+        if (!seeded) {
+            if (strcmp(cmd, "seed") != 0 || sscanf(line, "%*s %d", &n) != 1) {
+                fprintf(stderr, "oracle: scenario must start with seed (got %s)\n", cmd);
+                exit(6);
+            }
+            oracleRandomSeed(n);
+            seeded = true;
+            continue;
+        }
+        if (gOracleScnCount >= kOracleScenarioMaxCmds) {
+            fprintf(stderr, "oracle: scenario too long\n");
+            exit(6);
+        }
+        OracleScenarioCmd* c = &(gOracleScnCmds[gOracleScnCount]);
+        if (strcmp(cmd, "wait") == 0 && sscanf(line, "%*s %d", &n) == 1 && n >= 0) {
+            c->kind = 0;
+            c->arg = n;
+        } else if (strcmp(cmd, "end-turn") == 0) {
+            c->kind = 1;
+            c->arg = sscanf(line, "%*s %d", &n) == 1 ? n : 1;
+        } else {
+            fprintf(stderr, "oracle: unknown scenario command %s\n", cmd);
+            exit(6);
+        }
+        gOracleScnCount++;
+    }
+    fclose(in);
+    if (!seeded) {
+        fprintf(stderr, "oracle: scenario must start with seed\n");
+        exit(6);
+    }
+    gOracleScnIndex = 0;
+    // Armed only: the first command is fetched by the first tick's oracleTick, like every later one.
+    // Tick accounting (tools/fo2ce-trace/README.md): oracleTick runs at the START of tickersExecute,
+    // before that pass's tickers and the rest of the mainLoop iteration (the tick's "work"), so a
+    // command fetched at clock T counts the tick at T as its first work tick. `wait N` started at T
+    // ends at the first tick with clock >= T + N - before that tick's work - i.e. after exactly
+    // ceil(N / 10) work ticks. Fetching here (before the first tick, at clock C) instead would end a
+    // first `wait N` at C + N = the (N/10)-th tick, one work tick short. Nothing between this call and
+    // mainLoop's first tickersExecute does game work, so a scenario with no commands still exits with
+    // zero work ticks (at the first tick's step).
+    gOracleScnState = ORACLE_SCN_NEXT;
+}
+
+static void oracleScenarioStep()
+{
+    if (gOracleScnState == ORACLE_SCN_IDLE || gOracleScnInStep) {
+        return;
+    }
+    gOracleScnInStep = true;
+    // Loop over instantaneous transitions; return as soon as a state must wait for the engine.
+    for (;;) {
+        switch (gOracleScnState) {
+        case ORACLE_SCN_IDLE:
+            break;
+        case ORACLE_SCN_NEXT:
+            if (gOracleScnIndex >= gOracleScnCount) {
+                fprintf(stderr, "oracle: scenario done at clock %u after %u work ticks\n", gOracleClock, gOracleScnWorkTicks);
+                gOracleScnState = ORACLE_SCN_IDLE;
+                exit(0); // atexit closes the trace
+            }
+            if (gOracleScnCmds[gOracleScnIndex].kind == 0) {
+                gOracleScnUntil = gOracleClock + (unsigned int)gOracleScnCmds[gOracleScnIndex].arg;
+                gOracleScnState = ORACLE_SCN_WAIT_UNTIL;
+            } else {
+                gOracleScnTurnsLeft = gOracleScnCmds[gOracleScnIndex].arg;
+                gOracleScnUntil = gOracleClock + kOracleEndTurnCapMs;
+                gOracleScnState = ORACLE_SCN_ENDTURN_SEEK_INPUT;
+            }
+            continue;
+        case ORACLE_SCN_WAIT_UNTIL:
+            if (gOracleClock < gOracleScnUntil) break;
+            gOracleScnIndex++;
+            gOracleScnState = ORACLE_SCN_NEXT;
+            continue;
+        case ORACLE_SCN_ENDTURN_SEEK_INPUT:
+            if (gOracleScnTurnsLeft <= 0 || !isInCombat()) {
+                // count exhausted, or combat not active -> the action ends
+                gOracleScnIndex++;
+                gOracleScnState = ORACLE_SCN_NEXT;
+                continue;
+            }
+            if (gOracleDudeAwaitingInput) {
+                enqueueInputEvent(KEY_SPACE); // _combat_input: space ends the turn
+                gOracleScnUntil = gOracleClock + kOracleStepMs;
+                gOracleScnState = ORACLE_SCN_ENDTURN_PRESSED;
+                break;
+            }
+            if (gOracleClock >= gOracleScnUntil) oracleScenarioFailExit("end-turn cap reached seeking dude input", 7);
+            break;
+        case ORACLE_SCN_ENDTURN_PRESSED:
+            if (gOracleClock < gOracleScnUntil) break;
+            gOracleScnUntil = gOracleClock + kOracleEndTurnCapMs;
+            gOracleScnState = ORACLE_SCN_ENDTURN_SEEK_NEXT;
+            continue;
+        case ORACLE_SCN_ENDTURN_SEEK_NEXT:
+            if (!isInCombat() || gOracleDudeAwaitingInput) {
+                gOracleScnTurnsLeft--;
+                gOracleScnUntil = gOracleClock + kOracleEndTurnCapMs;
+                gOracleScnState = ORACLE_SCN_ENDTURN_SEEK_INPUT;
+                continue;
+            }
+            if (gOracleClock >= gOracleScnUntil) oracleScenarioFailExit("end-turn cap reached seeking next dude turn", 7);
+            break;
+        }
+        break;
+    }
+    gOracleScnInStep = false;
+    gOracleScnWorkTicks++; // still armed: this tick's work (tickers + mainLoop iteration) runs now
+}
+
+} // namespace fallout
