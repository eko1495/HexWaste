diff --git a/src/oracle.cc b/src/oracle.cc
new file mode 100644
index 00000000..145773e2
--- /dev/null
+++ b/src/oracle.cc
@@ -0,0 +1,88 @@
+#include "oracle.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "game_config.h"
+#include "random.h"
+
+namespace fallout {
+
+static bool gOracleEnabled = false;
+static unsigned int gOracleClock = 0;
+static long long gOracleExitAfterMs = -1;
+static char gOracleRngDumpPath[1024] = "";
+static int gOracleSeed = 12345;
+
+static constexpr unsigned int kOracleStepMs = 10;
+
+bool oracleEnabled()
+{
+    return gOracleEnabled;
+}
+
+void oracleInit()
+{
+    int enabled = 0;
+    configGetInt(&gGameConfig, "oracle", "enabled", &enabled);
+    gOracleEnabled = enabled != 0;
+    if (!gOracleEnabled) {
+        return;
+    }
+    int exitAfterMs = -1;
+    if (configGetInt(&gGameConfig, "oracle", "exit_after_ms", &exitAfterMs) && exitAfterMs >= 0) {
+        gOracleExitAfterMs = exitAfterMs;
+    }
+    char* dumpPath = nullptr;
+    if (configGetString(&gGameConfig, "oracle", "rng_dump", &dumpPath) && dumpPath != nullptr) {
+        snprintf(gOracleRngDumpPath, sizeof(gOracleRngDumpPath), "%s", dumpPath);
+    }
+    configGetInt(&gGameConfig, "oracle", "seed", &gOracleSeed);
+}
+
+const char* oracleRngDumpPath()
+{
+    return gOracleRngDumpPath;
+}
+
+int oracleSeed()
+{
+    return gOracleSeed;
+}
+
+void oracleWriteRngVectors(const char* path, int seed)
+{
+    FILE* out = fopen(path, "wt");
+    if (out == nullptr) {
+        exit(2);
+    }
+    static const int kRanges[][2] = { { 1, 100 }, { 1, 6 }, { 0, 0 }, { 0, 1 }, { 5, 1 }, { -10, 10 }, { 1, 25 } };
+    oracleRandomSeed(seed);
+    for (int i = 0; i < 1000; i++) {
+        const int* r = kRanges[i % 7];
+        int v = randomBetweenAt(r[0], r[1], "dump", "dump");
+        fprintf(out, "seed=%d min=%d max=%d -> %d\n", seed, r[0], r[1], v);
+    }
+    fclose(out);
+}
+
+unsigned int oracleTicks()
+{
+    return gOracleClock;
+}
+
+void oracleAdvanceClock(unsigned int ms)
+{
+    gOracleClock += ms;
+}
+
+void oracleTick()
+{
+    gOracleClock += kOracleStepMs;
+    if (gOracleExitAfterMs >= 0 && (long long)gOracleClock >= gOracleExitAfterMs) {
+        fprintf(stderr, "oracle: exit_after_ms=%lld reached at clock %u\n", gOracleExitAfterMs, gOracleClock);
+        exit(0);
+    }
+}
+
+} // namespace fallout
